{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.2.0",
  "default_locale": "zh_CN",
  "description": "__MSG_extDescription__",
  "permissions": [
    "storage",
    "contextMenus",
    "downloads",
    "activeTab",
    "clipboardWrite",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "options_page": "manage.html#settings",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": "icons/icon32.png"
  },
  "commands": {
    "save-page": {
      "suggested_key": {
        "default": "Alt+D"
      },
      "description": "__MSG_commandSaveDesc__"
    }
  }
}